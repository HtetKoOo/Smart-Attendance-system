# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Neon PostgreSQL connection string (pooled connection recommended for Next.js App Router)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.region.aws.neon.tech/dbname?sslmode=require"

# Neon PostgreSQL direct connection string (unpooled, used for migrations)
DIRECT_URL="postgresql://user:password@ep-sample.region.aws.neon.tech/dbname?sslmode=require"

# Better Auth Configuration
BETTER_AUTH_SECRET="generate_a_random_32_character_secret_key_here"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
